rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Copy this entire file into Firebase Console → Firestore → Rules → Publish.
    // Or: firebase deploy --only firestore:rules (after firebase login & use project)

    // A signed-in account is an admin only if it has a record in adminUsers.
    // The admin panel (/admin) reads the form collections through this check.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }

    // Admin directory. Seeded by `npm run seed:admin`, which signs in as the seed
    // address and writes its own record — hence the email pin on create: no other
    // authenticated account can promote itself to admin.
    match /adminUsers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'admin@unyta.com'
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 200
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() < 320
        && request.resource.data.role is string
        && request.resource.data.role.size() < 50;
      // An admin can edit its own name/email, but never its role.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt', 'updatedAt'])
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /creators/{docId} {
      allow create: if request.resource.data.size() == 5
        && request.resource.data.keys().hasOnly([
          'fullName',
          'email',
          'instagramHandle',
          'password',
          'createdAt'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() < 200
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() < 320
        && request.resource.data.instagramHandle is string
        && request.resource.data.instagramHandle.size() > 0
        && request.resource.data.instagramHandle.size() < 100
        && request.resource.data.password is string
        && request.resource.data.password.size() >= 8
        && request.resource.data.password.size() < 500;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /brands/{docId} {
      allow create: if request.resource.data.size() == 6
        && request.resource.data.keys().hasOnly([
          'fullName',
          'email',
          'instagramHandle',
          'websiteUrl',
          'password',
          'createdAt'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() < 200
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() < 320
        && request.resource.data.instagramHandle is string
        && request.resource.data.instagramHandle.size() > 0
        && request.resource.data.instagramHandle.size() < 100
        && (request.resource.data.websiteUrl == null
          || (request.resource.data.websiteUrl is string
            && request.resource.data.websiteUrl.size() < 2000))
        && request.resource.data.password is string
        && request.resource.data.password.size() >= 8
        && request.resource.data.password.size() < 500;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /brandDemoRequests/{docId} {
      allow create: if request.resource.data.keys().hasOnly([
          'fullName',
          'workEmail',
          'brandName',
          'industry',
          'numberOfLocations',
          'estimatedCampaignsPerMonth',
          'notes',
          'createdAt'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() < 200
        && request.resource.data.workEmail is string
        && request.resource.data.workEmail.size() > 3
        && request.resource.data.workEmail.size() < 320
        && request.resource.data.brandName is string
        && request.resource.data.brandName.size() > 0
        && request.resource.data.brandName.size() < 200
        && request.resource.data.industry is string
        && request.resource.data.industry.size() > 0
        && request.resource.data.industry.size() < 100
        && request.resource.data.numberOfLocations is string
        && request.resource.data.numberOfLocations.size() > 0
        && request.resource.data.numberOfLocations.size() < 100
        && request.resource.data.estimatedCampaignsPerMonth is string
        && request.resource.data.estimatedCampaignsPerMonth.size() > 0
        && request.resource.data.estimatedCampaignsPerMonth.size() < 100
        && (request.resource.data.notes == null
          || (request.resource.data.notes is string
            && request.resource.data.notes.size() < 2000));
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
